HOST_NX_OBJS += $(HOST_NX_BUILD)/gw_pack.o
HOST_NX_OBJS += $(HOST_NX_BUILD)/nx_platform_stub.o

.PHONY: host host_nx host_nx_prepare host_clean_nx

host: host_nx
	$(V)$(ECHO) "[ HOST ]" $(HOST_NX_BIN) "(NXEngine + ./$(NX_DATA_ROOT))"

host_nx: host_nx_prepare $(HOST_NX_BIN)

# Run tree: CaveStory/ must contain data/, Doukutsu.exe, sprites.sif, smalfont.bmp
host_nx_prepare:
	$(V)test -f $(NX_DATA_ROOT)/data/npc.tbl || (echo "missing $(NX_DATA_ROOT)/data — drop freeware Cave Story here" >&2; exit 1)
	$(V)test -f $(NX_DATA_ROOT)/Doukutsu.exe || (echo "missing $(NX_DATA_ROOT)/Doukutsu.exe" >&2; exit 1)
	$(V)cp -f $(NX_ROOT)/sprites.sif $(NX_DATA_ROOT)/sprites.sif
	$(V)cp -f $(NX_ROOT)/smalfont.bmp $(NX_DATA_ROOT)/smalfont.bmp
	$(V)cp -f $(NX_ROOT)/tilekey.dat $(NX_DATA_ROOT)/tilekey.dat
	$(V)cp -f $(NX_ROOT)/font.ttf $(NX_DATA_ROOT)/font.ttf 2>/dev/null || true

$(HOST_NX_ELF): $(HOST_NX_OBJS)
	$(V)$(ECHO) [ LD HOST NX ] $@
	$(V)$(HOST_NX_CXX) -o $@ $(HOST_NX_OBJS) $(HOST_NX_SDL_LIBS) -lm

# Launcher so cwd is CaveStory/ (data/, Doukutsu.exe, sprites.sif).
$(HOST_NX_BIN): $(HOST_NX_ELF) host_nx_prepare
	$(V)$(ECHO) [ WRAP ] $@
	$(V)printf '%s\n' \
		'#!/bin/sh' \
		'set -e' \
		'ROOT="$$(CDPATH= cd -- "$$(dirname "$$0")" && pwd)"' \
		'cd "$$ROOT/$(NX_DATA_ROOT)"' \
		'exec "$$ROOT/$(HOST_NX_ELF)" "$$@"' \
		> $@
	$(V)chmod +x $@

$(HOST_NX_BUILD)/%.o: $(NX_ROOT)/%.cpp
	$(V)mkdir -p $(dir $@)
	$(V)$(ECHO) [ CXX HOST ] $<
	$(V)$(HOST_NX_CXX) $(HOST_NX_CXXFLAGS) -c $< -o $@

$(HOST_NX_BUILD)/%.o: $(NX_ROOT)/%.c
	$(V)mkdir -p $(dir $@)
	$(V)$(ECHO) [ CC HOST ] $<
	$(V)$(HOST_NX_CC) $(HOST_NX_CFLAGS) -c $< -o $@

$(HOST_NX_BUILD)/gw_pack.o: src/platform/gw_pack.c
	$(V)mkdir -p $(dir $@)
	$(V)$(ECHO) [ CC HOST ] $<
	$(V)$(HOST_NX_CC) $(HOST_NX_CFLAGS) -c $< -o $@

$(HOST_NX_BUILD)/nx_platform_stub.o: host/nx_platform_stub.c
	$(V)mkdir -p $(dir $@)
	$(V)$(ECHO) [ CC HOST ] $<
	$(V)$(HOST_NX_CC) $(HOST_NX_CFLAGS) -c $< -o $@

# Convenience: build then run with correct cwd
.PHONY: host_run
host_run: host
	$(V)cd $(NX_DATA_ROOT) && ../$(HOST_NX_BIN)

host_clean_nx:
	$(V)rm -rf $(HOST_NX_BUILD)
	$(V)rm -f $(HOST_NX_BIN) $(HOST_NX_ELF)

clean:: host_clean_nx
