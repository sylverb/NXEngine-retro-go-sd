# Host build of upstream NXEngine (SDL 1.2) using ./CaveStory game data.
#
#   make host
#   ./CaveStory_host          # runs from CaveStory/ (cwd set by wrapper)
#
# Requires: SDL 1.2 (brew: sdl12-compat) — no SDL_ttf (bitmap font).

NX_ROOT      := third_party/nxengine
NX_DATA_ROOT := CaveStory
HOST_NX_ELF  := build/host/nxengine/nxengine
HOST_NX_BIN  := CaveStory_host
HOST_NX_BUILD := build/host/nxengine

HOST_NX_CC  ?= cc
HOST_NX_CXX ?= c++

HOST_NX_SDL_CFLAGS := $(shell pkg-config --cflags sdl 2>/dev/null)
HOST_NX_SDL_LIBS   := $(shell pkg-config --libs sdl 2>/dev/null)
ifeq ($(HOST_NX_SDL_LIBS),)
HOST_NX_SDL_CFLAGS := -I/opt/homebrew/include -I/usr/local/include
HOST_NX_SDL_LIBS   := -L/opt/homebrew/lib -L/usr/local/lib -lSDL
else
# pkg-config often yields -I.../include/SDL but sources use <SDL/SDL.h>
HOST_NX_SDL_CFLAGS += -I/opt/homebrew/include -I/usr/local/include
endif

HOST_NX_DEFS := -D_FILE_OFFSET_BITS=64

HOST_NX_INCLUDES := \
	-I$(NX_ROOT) \
	-I$(NX_ROOT)/common \
	-Isrc \
	-Ihost/macos_shims \
	$(HOST_NX_SDL_CFLAGS)

HOST_NX_CFLAGS := -O2 -g -Wall $(HOST_NX_DEFS) $(HOST_NX_INCLUDES)
HOST_NX_CXXFLAGS := $(HOST_NX_CFLAGS) -std=gnu++17 -fno-exceptions -fno-rtti

